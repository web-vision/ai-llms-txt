page {
    headerData {
        1761744920 = TEXT
        1761744920.value = <link rel="alternate" type="text/plain" href="/llms.txt" />
    }
}

llmstxt = PAGE
llmstxt {
    typeNum = 1699

    config {
        disableAllHeaderCode = 1
        additionalHeaders {
            10 {
                header = Content-Type: text/plain; charset=utf-8
                replace = 1
            }
            # Content is editor-controlled and served verbatim; without this a browser
            # may sniff the body as HTML and execute it instead of honouring text/plain.
            20 {
                header = X-Content-Type-Options: nosniff
                replace = 1
            }
        }
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 0
    }

    10 = USER
    10 {
        userFunc = WebVision\AiLlmsTxt\Controller\LlmsTxtController->generateAction
    }
}
